{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenContinuity",
  "version": "0.0.1",
  "identifier": "org.opencontinuity.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenContinuity",
        "width": 440,
        "height": 560,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Utility",
    "shortDescription": "Mac ve Windows arasında yerel ağda pano paylaşımı",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"]
      }
    }
  }
}
